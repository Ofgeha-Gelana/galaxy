Rscript -e 'if (!requireNamespace("BiocManager", quietly = TRUE)) install.packages("BiocManager"); BiocManager::install("MungeSumstats")'
if (!requireNamespace("BiocManager", quietly = TRUE))
    install.packages("BiocManager")
BiocManager::install("MungeSumstats")
q()
if (!requireNamespace("BiocManager", quietly = TRUE))
    install.packages("BiocManager")
BiocManager::install("MungeSumstats")
q()
if (!requireNamespace("BiocManager", quietly=TRUE))
    install.packages("BiocManager")
BiocManager::install("SNPlocs.Hsapiens.dbSNP155.GRCh37")
q()
library(MungeSumstats)
BiocManager::install("MungeSumstats", force = TRUE)
packageVersion("MungeSumstats")
library(MungeSumstats)
# Example: print available functions
ls("package:MungeSumstats")
q()
if (!requireNamespace("BiocManager", quietly = TRUE))
    install.packages("BiocManager")
BiocManager::install("BSgenome.Hsapiens.1000genomes.hs37d5")
# Create user R library path if it doesn't exist
user_lib <- Sys.getenv("R_LIBS_USER")
if (!dir.exists(user_lib)) dir.create(user_lib, recursive = TRUE)
# Add it to your library path
.libPaths(user_lib)
options(timeout = 1200)  # 20 minutes
BiocManager::install("BSgenome.Hsapiens.1000genomes.hs37d5")
q()
install.packages("BiocManager")
BiocManager::install("MungeSumstats")
install.packages("susieR")

q()
